_modules["auth"] = function()
    -- Module: auth | Single-key authentication
    -- The original remote/multi-key authentication has been replaced with
    -- one local key. All public Auth methods used by the UI are preserved.

    local Utils = nil
    local Auth = {}

    -- Set your ONE authentication key here.
    -- Do not commit a real production secret to a public repository.
    local SINGLE_AUTH_KEY = "NEXUS-TEST-2026"

    -- Development-only switch. Keep false for normal authentication.
    local DEV_MODE = true

    Auth.IsAuthenticated = false
    Auth.KeyData = nil
    Auth.FreeKeyData = nil

    function Auth.init(utilsModule)
        Utils = utilsModule
        Auth.IsAuthenticated = false
        Auth.KeyData = nil
        Auth.FreeKeyData = nil
    end

    local function normalizeKey(key)
        if type(key) ~= "string" then
            return ""
        end
        return key:gsub("^%s+", ""):gsub("%s+$", "")
    end

    function Auth.enableDevMode()
        if not DEV_MODE then return false end
        Auth.IsAuthenticated = true
        Auth.KeyData = {
            key = "DEV_MODE",
            expiresIn = math.huge,
            hwidBound = false,
            isFreeKey = false,
            isPremium = true,
            discordLinked = false
        }
        return true
    end

    function Auth.validateKey(key, callback)
        key = normalizeKey(key)

        if key == "" then
            callback(false, "Please enter your key")
            return
        end

        if SINGLE_AUTH_KEY == "YOUR_SINGLE_KEY_HERE" then
            callback(false, "Single authentication key is not configured")
            return
        end

        if key == SINGLE_AUTH_KEY then
            Auth.IsAuthenticated = true
            Auth.KeyData = {
                key = key,
                expiresIn = math.huge,
                hwidBound = false,
                isFreeKey = false,
                isPremium = true,
                discordLinked = false
            }

            if Utils and Utils.saveKey then
                Utils.saveKey(key)
            end

            callback(true, "Valid", Auth.KeyData)
        else
            Auth.IsAuthenticated = false
            Auth.KeyData = nil
            callback(false, "Invalid key")
        end
    end

    function Auth.tryCachedKey(callback)
        if not Utils or not Utils.loadKey then
            callback(false, "No cached key")
            return
        end

        local cachedKey = Utils.loadKey()
        if cachedKey and cachedKey ~= "" then
            Auth.validateKey(cachedKey, callback)
        else
            callback(false, "No cached key")
        end
    end

    function Auth.isAuthenticated()
        return Auth.IsAuthenticated == true
    end

    function Auth.getRemainingTime()
        if Auth.IsAuthenticated then
            return math.huge
        end
        return 0
    end

    function Auth.logout()
        Auth.IsAuthenticated = false
        Auth.KeyData = nil
        Auth.FreeKeyData = nil
        if Utils and Utils.clearKey then
            Utils.clearKey()
        end
    end

    -- Kept for UI compatibility. Free-key generation is no longer needed
    -- because this build uses exactly one configured authentication key.
    function Auth.requestFreeKey(callback)
        callback(false, "Free keys are disabled in single-key mode")
    end

    function Auth.getFreeKeyStatus(callback)
        callback(false, "Free keys are disabled in single-key mode")
    end

    function Auth.isFreeKey()
        return false
    end

    function Auth.isPremium()
        return Auth.IsAuthenticated == true
    end

    function Auth.isDiscordLinked()
        return false
    end

    function Auth.openGetKeyPage()
        if Utils and Utils.notify then
            Utils.notify("NexusBounty", "Enter the configured single authentication key.", 4)
        end
    end

    return Auth
end

